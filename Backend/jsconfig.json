{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*.js",
    "scripts/**/*.js",
    "migrations/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
